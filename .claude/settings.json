{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(echo:*)",
      "Bash(vim:*)",
      "Bash(done)",
      "Read(//tmp/**)"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/skills/extract/extract.py --stdin"
          }
        ]
      }
    ]
  },
  "agentPushNotifEnabled": true
}
